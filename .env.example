# Relay CRM native development. Defaults work without external credentials.
DATABASE_URL=sqlite:///./erp.db
ENVIRONMENT=development
SIGNUP_ENABLED=true
LOG_LEVEL=INFO
API_PORT=8010
FRONTEND_PORT=3007
BACKEND_URL=http://127.0.0.1:8010
CORS_ORIGINS=["http://localhost:3007","http://127.0.0.1:3007"]
# Optional explicit fictional demo owner, never enabled in production.
DEMO_SEED=false
DEMO_EMAIL=owner@demo.local
# Set your own password before enabling DEMO_SEED. Otherwise use signup.
DEMO_PASSWORD=
# Gmail OAuth is deferred by user request. No external credentials required.
